[TEMPLATE]
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
# Only public values belong in this file. Vite inlines every VITE_ variable
# into the browser bundle, so the publishable (anon) key is fine here but the
# service-role key, database password and any other secret must never be. All
# access rules live in the database as Row Level Security policies.
